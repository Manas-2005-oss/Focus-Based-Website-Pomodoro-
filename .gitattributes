# Normalize line endings for text files and prevent LF/CRLF warnings
* text=auto

# Explicit text formats
*.html text
*.css text
*.js text
*.jsx text
*.ts text
*.tsx text
*.json text
*.md text
*.yml text
*.yaml text
*.txt text
*.lock text
*.env text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
